{
  "info": {
    "name": "PokeComp API",
    "description": "Backend tests for PokeComp. Run with the 'PokeComp Local' environment selected and the backend running (npm run dev:backend). Run folders in order: 1 Setup logs in first, 3 Teams creates and then deletes its own team, 4 User changes the password and changes it back.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1 Setup",
      "item": [
        {
          "name": "Health check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Says hello\", () => {",
                  "    pm.expect(pm.response.json().message).to.eql(\"Hello, World!\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/"
          }
        },
        {
          "name": "Login (Supabase)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Returns an access token and saves it\", () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.access_token).to.be.a(\"string\").and.not.empty;",
                  "    pm.environment.set(\"token\", body.access_token);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{supabaseKey}}"
              }
            ],
            "url": "{{supabaseUrl}}/auth/v1/token?grant_type=password",
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"{{testEmail}}\",\n    \"password\": \"{{testPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Logs the test account in through Supabase Auth and saves the access token for every later request."
          }
        }
      ]
    },
