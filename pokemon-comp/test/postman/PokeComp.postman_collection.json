      "item": [
        {
          "name": "Create team",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Creates an empty team called New Team and saves its id\", () => {",
                  "    const team = pm.response.json();",
                  "    pm.expect(team.name).to.eql(\"New Team\");",
                  "    pm.expect(team.id).to.exist;",
                  "    pm.environment.set(\"teamId\", team.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/teams"
          }
        },
        {
          "name": "List teams",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Returns an array that includes the new team\", () => {",
                  "    const teams = pm.response.json();",
                  "    pm.expect(teams).to.be.an(\"array\");",
                  "    const ids = teams.map(t => String(t.id));",
                  "    pm.expect(ids).to.include(String(pm.environment.get(\"teamId\")));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/teams"
          }
        },
        {
          "name": "Get one team",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Returns the right team with an empty team_pokemon list\", () => {",
                  "    const team = pm.response.json();",
                  "    pm.expect(String(team.id)).to.eql(String(pm.environment.get(\"teamId\")));",
                  "    pm.expect(team.team_pokemon).to.be.an(\"array\").that.is.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/teams/{{teamId}}"
          }
        },
