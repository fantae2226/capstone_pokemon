                  "pm.test(\"Name was trimmed and saved\", () => {",
                  "    pm.expect(pm.response.json().name).to.eql(\"Postman Team\");",
                  "});",
                  "",
                  "pm.test(\"Garchomp was saved in slot 0 with its moves and EVs\", () => {",
                  "    const p = pm.response.json().team_pokemon[0];",
                  "    pm.expect(p.slot).to.eql(0);",
                  "    pm.expect(p.species_id).to.eql(445);",
                  "    pm.expect(p.move1).to.eql(\"earthquake\");",
                  "    pm.expect(p.move2).to.eql(\"dragon-claw\");",
                  "    pm.expect(p.move3).to.eql(null);",
